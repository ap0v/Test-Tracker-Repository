# Copy to .env.local and fill in the values. This is Java properties format:
# do not wrap values in quotes or prefix keys with export.
# JDBC URLs must not contain username:password@ before the hostname.
# Keep credentials in the separate username and password settings below.
SUPABASE_DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
